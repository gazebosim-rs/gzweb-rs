--- a/src/systems/websocket_server/WebsocketServer.cc
+++ b/src/systems/websocket_server/WebsocketServer.cc
@@ -648,6 +648,23 @@ void WebsocketServer::OnDisconnect(int _socketId)
 
   this->connections.erase(_socketId);
 
+  // The client's publishers go with it. A drive it commanded (a
+  // gz.msgs.Twist topic) gets a last, empty (zero) command, so a robot
+  // doesn't keep driving after a closed tab or a dropped connection.
+  for (auto it = this->clientPublishers.begin();
+       it != this->clientPublishers.end();)
+  {
+    if (it->second.sockets.erase(_socketId) > 0 &&
+        it->second.type == "gz.msgs.Twist")
+    {
+      it->second.publisher.PublishRaw("", it->second.type);
+    }
+    if (it->second.sockets.empty())
+      it = this->clientPublishers.erase(it);
+    else
+      ++it;
+  }
+
   // Somewhat slow operation.
   for (std::map<std::string, std::set<int>>::iterator iter =
        this->topicConnections.begin(); iter != this->topicConnections.end();
@@ -672,13 +689,20 @@ void WebsocketServer::OnMessage(int _socketId, const std::string _msg)
   // Frame: operation,topic,type,payload
   std::vector<std::string> frameParts;
 
-  // A request carries a serialized protobuf as its payload, which can hold
-  // commas and zero bytes. Take everything after the third comma verbatim
-  // instead of splitting the whole frame.
-  const std::string reqPrefix = this->operations[REQUEST] + ",";
+  // A request or a client's publication carries a serialized protobuf as
+  // its payload, which can hold commas and zero bytes. Take everything after
+  // the third comma verbatim instead of splitting the whole frame.
+  std::string verbatimOp;
+  for (const std::string &op : {this->operations[REQUEST],
+                                std::string("pub_in")})
+  {
+    if (_msg.compare(0, op.size() + 1, op + ",") == 0)
+      verbatimOp = op;
+  }
+  const std::string reqPrefix = verbatimOp + ",";
   std::size_t svcEnd = std::string::npos;
   std::size_t typeEnd = std::string::npos;
-  if (_msg.compare(0, reqPrefix.size(), reqPrefix) == 0)
+  if (!verbatimOp.empty())
   {
     svcEnd = _msg.find(',', reqPrefix.size());
     if (svcEnd != std::string::npos)
@@ -688,7 +712,7 @@ void WebsocketServer::OnMessage(int _socketId, const std::string _msg)
   if (typeEnd != std::string::npos)
   {
     frameParts = {
-        this->operations[REQUEST],
+        verbatimOp,
         _msg.substr(reqPrefix.size(), svcEnd - reqPrefix.size()),
         _msg.substr(svcEnd + 1, typeEnd - svcEnd - 1),
         _msg.substr(typeEnd + 1)};
@@ -1089,6 +1113,62 @@ void WebsocketServer::OnMessage(int _socketId, const std::string _msg)
   {
     this->OnRequest(_socketId, frameParts);
   }
+  else if (frameParts[0] == "pub_in")
+  {
+    this->OnPublishIn(_socketId, frameParts);
+  }
+}
+
+//////////////////////////////////////////////////
+void WebsocketServer::OnPublishIn(int _socketId,
+    const std::vector<std::string> &_frameParts)
+{
+  const std::string &topic = _frameParts[1];
+  const std::string &msgType = _frameParts[2];
+  if (topic.empty() || msgType.empty())
+  {
+    gzerr << "A publication needs a topic and a message type\n";
+    return;
+  }
+
+  // OnMessage and OnDisconnect both run on the websocket service thread,
+  // so the publishers need no lock of their own.
+  auto it = this->clientPublishers.find(topic);
+  if (it != this->clientPublishers.end() && it->second.type != msgType)
+  {
+    // A topic is advertised with one type at a time.
+    it->second.sockets.erase(_socketId);
+    if (!it->second.sockets.empty())
+    {
+      gzerr << "Topic[" << topic << "] is published with type["
+            << it->second.type << "], not [" << msgType << "]\n";
+      return;
+    }
+    this->clientPublishers.erase(it);
+    it = this->clientPublishers.end();
+  }
+  if (it == this->clientPublishers.end())
+  {
+    if (this->clientPublishers.size() >= kMaxClientPublishers)
+    {
+      gzerr << "Unable to publish on topic[" << topic << "]: the clients "
+            << "already publish on " << kMaxClientPublishers << " topics\n";
+      return;
+    }
+    transport::Node::Publisher pub = this->node.Advertise(topic, msgType);
+    if (!pub)
+    {
+      gzerr << "Unable to advertise topic[" << topic << "] with type["
+            << msgType << "]\n";
+      return;
+    }
+    it = this->clientPublishers.emplace(
+        topic, ClientPublisher{msgType, pub, {}}).first;
+  }
+  it->second.sockets.insert(_socketId);
+
+  if (!it->second.publisher.PublishRaw(_frameParts[3], msgType))
+    gzerr << "Unable to publish on topic[" << topic << "]\n";
 }
 
