diff --git a/src/systems/websocket_server/WebsocketServer.cc b/src/systems/websocket_server/WebsocketServer.cc
index 0af67cb..7690206 100644
--- a/src/systems/websocket_server/WebsocketServer.cc
+++ b/src/systems/websocket_server/WebsocketServer.cc
@@ -347,10 +347,37 @@ int rootCallback(struct lws *_wsi,
           // Return non-zero to close the connection.
           return -1;
         }
+        auto conn = self->connections.find(fd);
+        if (conn == self->connections.end())
+          break;
+
+        // libwebsockets hands over what one read from the socket holds
+        // (4096 bytes at most), so a message can arrive in pieces: a long
+        // one always does, and so can a short one that shares a read with
+        // the message before it. Join the pieces, and read the message
+        // once its last one is in.
+        std::string &incoming = conn->second->incoming;
+        if (incoming.size() + _len > WebsocketServer::kMaxMessageSize)
+        {
+          gzerr << "Closing a connection whose message is longer than "
+                << WebsocketServer::kMaxMessageSize << " bytes\n";
+          incoming.clear();
+          std::string reason = "message_too_big";
+          lws_close_reason(_wsi, LWS_CLOSE_STATUS_MESSAGE_TOO_LARGE,
+            reinterpret_cast<unsigned char *>(reason.data()), reason.size());
+          return -1;
+        }
         // Use the length libwebsockets reports. Binary payloads contain zero
         // bytes, so treating the frame as a C string would truncate it.
-        self->OnMessage(fd,
-            std::string(static_cast<const char *>(_in), _len));
+        incoming.append(static_cast<const char *>(_in), _len);
+        if (!lws_is_final_fragment(_wsi) ||
+            lws_remaining_packet_payload(_wsi) > 0)
+        {
+          break;
+        }
+        std::string msg;
+        msg.swap(incoming);
+        self->OnMessage(fd, msg);
         break;
       }
 
