<?xml version="1.0"?>
<!--
  gz-sim server configuration for the gz-websocket-jetty image
  (GZ_SIM_SERVER_CONFIG_PATH points here; see Dockerfile.gazebo).

  It replaces gz-sim's default server.config, so it repeats that file's three
  systems (Physics, UserCommands, SceneBroadcaster) and adds the websocket
  server. Since Ionic (gz-sim 9), server-config systems are loaded into every
  world, after the world's own, unless the world opts out with
  <gz:policies><include_server_config_plugins>false</...></gz:policies> (the
  Harmonic default), and a system the world already loads is skipped
  (gz-sim's tutorials/server_config.md). So any world gets
  the websocket server on port 9002 without being edited, and a world that
  already has one doesn't get a second.
-->
<server_config>
  <plugins>
    <plugin entity_name="*"
            entity_type="world"
            filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics">
    </plugin>
    <plugin entity_name="*"
            entity_type="world"
            filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin entity_name="*"
            entity_type="world"
            filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin entity_name="*"
            entity_type="world"
            filename="gz-sim-websocket-server-system"
            name="gz::sim::systems::WebsocketServer">
      <port>9002</port>
      <publication_hz>60</publication_hz>
    </plugin>
  </plugins>
</server_config>
